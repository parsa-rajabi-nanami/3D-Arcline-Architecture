{
  "name": "arcline-architecture",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "build:dev": "vite build --mode development && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview --outDir .output/public",
    "build:pages": "npm run build && cp .output/public/index.html .output/public/404.html",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d .output/public -b gh-pages --nojekyll",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "lucide-react": "^0.575.0",
    "gsap": "^3.15.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-wrap-balancer": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.1.5",
    "vitest": "^5.0.0"
  }
}
